# ==============================================================================
# Just Sortd - Ops Brain Environment Variables
# Copy to .env and replace with your real secrets. NEVER commit .env to Git.
# ==============================================================================

# LLM Providers (At least one required for live API extraction; fallback demo mode works without keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Notion Integration
NOTION_API_KEY=ntn_your_notion_secret_token_here
NOTION_TASKS_DB_ID=your_tasks_database_id_here
NOTION_GOALS_DB_ID=your_goals_database_id_here
NOTION_RUNS_DB_ID=your_ai_run_logs_database_id_here

# Slack Webhook (For human approval card & #ops-alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_SLACK_WEBHOOK_URL_HERE
SLACK_OPS_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_OPS_ALERTS_WEBHOOK_URL_HERE

# App Environment
ENVIRONMENT=development
DRY_RUN=true
